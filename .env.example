DATABASE_URL="file:./dev.db"
JWT_SECRET="playup-dev-secret-change-in-production"

# Google Maps (required for interactive park map)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-javascript-api-key"
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID="your-google-map-id"

# Google Places (required for park business listings on server)
GOOGLE_MAPS_API_KEY="your-google-places-api-key"

# Turso (production database — only needed when deploying)
# DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"
